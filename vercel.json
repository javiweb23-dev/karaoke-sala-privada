{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/karaoke",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/karaoke",
      "destination": "/karaoke.html"
    },
    {
      "source": "/reserva",
      "destination": "/reserva.html"
    },
    {
      "source": "/resenas",
      "destination": "/resenas.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    }
  ]
}
